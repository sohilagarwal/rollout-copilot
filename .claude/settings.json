{
  "permissions": {
    "allow": ["mcp__rollout"],
    "ask": [
      "mcp__rollout__decide_change_request",
      "mcp__rollout__update_site",
      "mcp__rollout__add_site"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/server/start.sh --setup-only"
          }
        ]
      }
    ]
  }
}
